# === LLM Providers ===
# Primary LLM provider: claude | openai | gemini | local
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=sk-ant-api03-...
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# Vision provider (can differ from LLM provider)
VISION_PROVIDER=claude
VISION_MODEL=claude-opus-4-6
VISION_API_KEY=sk-ant-api03-...

# Local/Ollama fallback (optional)
LOCAL_LLM_ENDPOINT=http://localhost:11434/api/chat
LOCAL_VISION_ENDPOINT=http://localhost:11434/api/chat

# === Vector Database ===
CHROMA_PERSIST_DIR=./data/corpus/embeddings
CHROMA_COLLECTION_NAME=fixeragent_manuals

# Qdrant (Phase 2+)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# === Redis (Phase 3+) ===
REDIS_URL=redis://localhost:6379/0

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=./data/logs/fixeragent.log

# === External APIs ===
IFIXIT_API_KEY=
REPAIRCLINIC_API_KEY=

# === Agent Config ===
DIAGNOSTIC_CONFIDENCE_THRESHOLD=0.80
DEVICE_ID_CONFIDENCE_THRESHOLD=0.85
SAFETY_ESCALATION_ENABLED=true
KNOWLEDGE_CRAWL_SCHEDULE=0 2 * * 0

# === Paths ===
KNOWLEDGE_BRAIN_PATH=./data/knowledge_brain/SECOND-KNOWLEDGE-BRAIN.md
DEVICE_CATALOG_PATH=./data/device_catalog/devices.json
FEEDBACK_LOG_PATH=./data/feedback_logs/outcomes.jsonl
MANUALS_DIR=./data/manuals
